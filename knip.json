{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "servers/cloud/backend": {
      "entry": ["api/index.ts", "drizzle.config.ts", "test/**/*.test.ts"],
      "project": ["**/*.ts"],
      // Runs inside the `doppler run -- tsx …` dev script, which knip can't
      // see through to resolve the binary.
      "ignoreDependencies": ["tsx"],
      // The plugin executes drizzle.config.ts, which parses (Doppler-backed)
      // env and throws under a bare `npx knip`. Treated as a plain entry above.
      "drizzle": false
    },
    "servers/local": {
      "entry": ["test/**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    // Entries/project come from the vite plugin's defaults.
    "client": {}
  }
}
