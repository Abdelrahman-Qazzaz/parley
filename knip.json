{
  // Run it as `npm run knip`, which turns off oxc-parser's raw transfer: its
  // multi-gigabyte buffer fails to allocate in the sandbox.
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "servers/cloud/backend": {
      // scripts/build.ts bundles the one-shots as entrypoints of their own.
      "entry": [
        "src/index.ts",
        "scripts/*.ts",
        "drizzle.config.ts",
        "test/**/*.test.ts",
      ],
      "project": ["**/*.ts"],
      // The plugin executes drizzle.config.ts, which parses (Doppler-backed)
      // env and throws under a bare `npx knip`. Treated as a plain entry above.
      "drizzle": false
    },
    "servers/local": {
      "entry": ["test/**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    // Entries/project come from the vite plugin's defaults.
    "client": {}
  }
}
